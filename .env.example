# Copy to .env for running the API or worker directly on your machine
# (uvicorn / python -m worker.main) against the Docker Compose services.
# These are local development values only. Never put real credentials here.

DATABASE_URL=postgresql+psycopg://linkpulse:linkpulse@localhost:5433/linkpulse
REDIS_URL=redis://localhost:6380/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BASE_URL=http://localhost:8000

# Optional (defaults shown)
# CACHE_TTL_SECONDS=3600
# CREATE_RATE_LIMIT_PER_MINUTE=10
# CLICKS_TOPIC=clicks
# APP_VERSION=dev

# Used by pytest (tests/conftest.py)
# TEST_DATABASE_URL=postgresql+psycopg://linkpulse:linkpulse@localhost:5433/linkpulse_test
